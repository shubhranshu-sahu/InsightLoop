# ══════════════════════════════════════════════════════════════════════════════
# InsightLoop AI Service — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored — NEVER commit it with real secrets.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret between Node backend and this service.
# Node sends this as: X-Internal-Secret: <INTERNAL_SECRET>
# All routes except /health require this header → 403 if missing or wrong.
INTERNAL_SECRET=your_very_secret_key_here

# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/
# Used for: LLM calls (analysis + summarization) AND embeddings
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model for LLM calls
# Options: gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash
GEMINI_LLM_MODEL=gemini-2.0-flash

# Gemini model for text embeddings
# Options: models/text-embedding-004, models/embedding-001
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# ── LangSmith (Tracing & Monitoring) ─────────────────────────────────────────
# Highly recommended — set up from day one.
# Gives full trace visibility into every LangGraph run, token usage, latency.
# Get key from: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls__your_langsmith_key_here
LANGCHAIN_PROJECT=insightloop-dev

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Same MongoDB instance as the Node backend.
# FastAPI reads responses.answers + writes responses.ai_analysis
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=insightloop

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Same MySQL instance as the Node backend.
# FastAPI reads: questions table (for schema context in chat)
# FastAPI writes: alerts table (after processing high-urgency responses)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DB=insightloop
MYSQL_POOL_MIN=1
MYSQL_POOL_MAX=5
# Set to true for cloud MySQL (PlanetScale, AWS RDS, etc.)
MYSQL_SSL=false

# ── Vector Store ─────────────────────────────────────────────────────────────
# "chroma" = local ChromaDB (dev/testing)
# "qdrant" = cloud Qdrant (production)
# Switching backends: change this value + set QDRANT_* vars below.
# No code changes needed anywhere.
VECTOR_STORE_BACKEND=chroma

# ChromaDB (used when VECTOR_STORE_BACKEND=chroma)
# Local directory where ChromaDB persists its index files.
# Gitignored — can be regenerated from MongoDB if lost.
VECTOR_STORE_PATH=./data/vectorstore
CHROMA_COLLECTION_NAME=feedback_responses

# Qdrant (used when VECTOR_STORE_BACKEND=qdrant)
# Leave empty while using ChromaDB locally.
# Install when switching: pip install langchain-qdrant qdrant-client
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=feedback_responses

# ── Alert Thresholds ──────────────────────────────────────────────────────────
# Number of high-urgency responses in the time window to trigger an alert
ALERT_HIGH_URGENCY_THRESHOLD=3

# Time window (in hours) to count high-urgency responses
ALERT_WINDOW_HOURS=6
